    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output ?? $json.text ?? $json.response ?? $json;\nlet r = raw;\nif (typeof raw === 'string') { const cleaned = raw.replace(/^```json\\s*/i,'').replace(/^```\\s*/,'').replace(/\\s*```$/,'').trim(); r = JSON.parse(cleaned); }\nconst allowed = ['RESPUESTA_PROPUESTA','SOLICITAR_DATOS','ESCALAR_HUMANO'];\nif (!r || !allowed.includes(r.accion) || typeof r.confianza !== 'number' || r.confianza < 0 || r.confianza > 1 || typeof r.motivo !== 'string' || r.requiere_revision_humana !== true) throw new Error('Salida del agente inválida.');\nconst ctx = $('Combinar incidencia y registro').first().json;\nif (!ctx.registro_encontrado) r.accion = 'ESCALAR_HUMANO';\nif (r.accion === 'RESPUESTA_PROPUESTA' && (r.confianza < 0.80 || !String(r.respuesta_propuesta ?? '').trim())) r.accion = 'ESCALAR_HUMANO';\nreturn { json: { request_id: ctx.request_id, order_id: ctx.order_id, proveedor_reportado: ctx.proveedor_reportado, proveedor_registrado: ctx.proveedor_registrado, accion: r.accion, confianza: r.confianza, motivo: r.motivo, respuesta_propuesta: r.respuesta_propuesta ?? '', campos_faltantes: JSON.stringify(r.campos_faltantes ?? []), estado_revision: 'Pendiente de revisión humana', fecha: new Date().toISOString() } };"
      },
