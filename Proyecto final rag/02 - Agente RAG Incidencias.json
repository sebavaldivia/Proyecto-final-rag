      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body ?? $json;\n\nconst required = [\n  'request_id',\n  'proveedor_reportado',\n  'detalle'\n];\n\nconst missing = required.filter(\n  k => !String(b[k] ?? '').trim()\n);\n\nreturn {\n  json: {\n    ...b,\n    entrada_valida: missing.length === 0,\n    campos_faltantes: missing,\n    order_id: String(b.order_id ?? '').trim(),\n    proveedor_reportado: String(\n      b.proveedor_reportado ?? ''\n    ).trim(),\n    origen: 'webhook'\n  }\n};"
      },
